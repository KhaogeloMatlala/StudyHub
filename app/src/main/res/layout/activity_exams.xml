<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/studyhub_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvExamsTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Exams &amp; Calendar"
            android:textColor="@color/studyhub_purple"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvExamsSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Keep track of your upcoming exams"
            android:textColor="@color/studyhub_secondary_text"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Add an Exam"
            android:textColor="@color/studyhub_text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etExamTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Exam title"
            android:inputType="text"
            android:padding="12dp" />

        <EditText
            android:id="@+id/etExamDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="Description"
            android:inputType="textMultiLine"
            android:minLines="2"
            android:gravity="top"
            android:padding="12dp" />

        <EditText
            android:id="@+id/etExamDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="Exam date (YYYY-MM-DD)"
            android:inputType="date"
            android:padding="12dp" />

        <EditText
            android:id="@+id/etExamVenue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="Venue"
            android:inputType="text"
            android:padding="12dp" />

        <Button
            android:id="@+id/btnAddExam"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="ADD EXAM"
            android:textStyle="bold"
            android:backgroundTint="@color/studyhub_purple" />

        <ProgressBar
            android:id="@+id/examsProgressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvUpcomingExams"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="Upcoming Exams"
            android:textColor="@color/studyhub_text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/examContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical" />

    </LinearLayout>

</ScrollView>