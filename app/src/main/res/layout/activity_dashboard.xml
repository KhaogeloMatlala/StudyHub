<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvWelcome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="Welcome to StudyHub!"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#3F51B5" />

        <TextView
            android:id="@+id/tvDashboardSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Stay organised. Study smarter. Achieve more."
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvToday"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="Today's Overview"
            android:textSize="22sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTasksCard"
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_weight="1"
                android:gravity="center"
                android:padding="12dp"
                android:text="Tasks\n0 completed"
                android:textSize="17sp"
                android:textStyle="bold"
                android:background="#E8EAF6" />

            <Space
                android:layout_width="12dp"
                android:layout_height="1dp" />

            <TextView
                android:id="@+id/tvStudyCard"
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_weight="1"
                android:gravity="center"
                android:padding="12dp"
                android:text="Study Time\n0 minutes"
                android:textSize="17sp"
                android:textStyle="bold"
                android:background="#E8EAF6" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvPoints"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="⭐ Points: 0"
            android:textSize="22sp"
            android:textStyle="bold"
            android:background="#FFF3E0" />

        <TextView
            android:id="@+id/tvStreak"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="🔥 Study Streak: 0 days"
            android:textSize="22sp"
            android:textStyle="bold"
            android:background="#FCE4EC" />

        <TextView
            android:id="@+id/tvUpcoming"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="StudyHub Features"
            android:textSize="22sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnTasks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Tasks &amp; Assignments" />

        <Button
            android:id="@+id/btnSubjects"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Subjects" />

        <Button
            android:id="@+id/btnExams"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Exams &amp; Calendar" />

        <Button
            android:id="@+id/btnFocus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Focus Timer" />

        <Button
            android:id="@+id/btnProfile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Profile &amp; Settings" />

    </LinearLayout>

</ScrollView>